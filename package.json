    "@types/pg": "^8.10.0",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "autocannon": "^8.0.0",
    "jest": "^29.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
