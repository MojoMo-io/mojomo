# Database
DATABASE_URL=postgresql://mojomo:mojomo_password@localhost:5432/mojomo
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mojomo
DB_USER=mojomo
DB_PASSWORD=mojomo_password

# Server
NODE_ENV=development
PORT=8002
API_URL=http://localhost:8002

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_API_URL=https://api.telegram.org

# JWT (for future auth)
JWT_SECRET=your_jwt_secret_key_here

# Environment
LOG_LEVEL=info
# --- LLM provider (all model calls route through src/services/llm.ts) ---
LLM_PROVIDER=deepseek          # 'deepseek' (default) or 'anthropic'
DEEPSEEK_API_KEY=sk-
DEEPSEEK_MODEL=deepseek-chat   # or deepseek-reasoner
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Per-million-token rates used for the cost column (DeepSeek defaults shown)
DEEPSEEK_COST_INPUT_PER_MTOK=0.28
DEEPSEEK_COST_OUTPUT_PER_MTOK=0.42

# Only needed when LLM_PROVIDER=anthropic
CLAUDE_API_KEY=sk-ant-
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Build scope (see ROADMAP.md). Both default to off.
TOKENS_ENABLED=false
SPECIALISTS_ENABLED=false
# Dormancy sweep
DORMANT_CHECK_INTERVAL_MS=21600000
DORMANT_INACTIVITY_DAYS=90
# DB pool
DB_POOL_MAX=20
DB_CONNECT_TIMEOUT_MS=10000

# Phase 5 auth (required in production)
SITE_ACCESS_PASSWORD=change-me
PUBLIC_URL=https://mojomo.io
SMTP_URL=smtp://127.0.0.1:25
MAIL_FROM=house@house.mojomo.io
MAIL_FROM_NAME=MOJOMO
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MIN=20
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=5
# MAIL_PROVIDER=console  # dev only: log links instead of sending
MAIL_REPLY_TO=house@house.mojomo.io
# Comma-separated extra domains MAIL_FROM may use. Sending transactional mail
# from a dedicated subdomain keeps a bad reputation off the primary domain.
# house.mojomo.io has its own SPF, DKIM and strict-alignment DMARC for this.
MAIL_ALLOWED_SENDER_DOMAINS=house.mojomo.io
