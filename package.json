    "dotenv": "^16.3.0",
    "ethers": "^6.17.0",
    "express": "^4.18.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "nodemailer": "^9.1.1",
    "pg": "^8.10.0",
    "prom-client": "^15.1.3",
